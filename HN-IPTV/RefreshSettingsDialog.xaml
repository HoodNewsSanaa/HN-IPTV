<Window x:Class="HnIptv.RefreshSettingsDialog" Icon="Assets/HN-IPTV.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Playlist refresh settings"
        Width="400" Height="320" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#111927" Foreground="White" FontFamily="Segoe UI">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="14,9"/>
            <Button Content="Save" Click="Save_Click" Padding="14,9"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Automatic refresh intervals" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14"/>
            <TextBlock Text="Channel list (hours)"/><TextBox x:Name="ChannelsBox" Margin="0,5,0,12" Padding="8"/>
            <TextBlock Text="EPG (minutes)"/><TextBox x:Name="EpgBox" Margin="0,5,0,12" Padding="8"/>
            <TextBlock Text="Channel logos / metadata (hours)"/><TextBox x:Name="LogosBox" Margin="0,5,0,12" Padding="8"/>
            <TextBlock Text="EPG and channels refresh without stopping playback." Foreground="#9FB1C8" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
