<Window x:Class="HnIptv.RenamePlaylistDialog" Icon="Assets/HN-IPTV.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rename playlist" Width="390" Height="190"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#111927" Foreground="White">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,9,0" Padding="12,7"/>
            <Button Content="Save" Click="Save_Click" Padding="15,7"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Playlist name" Margin="0,0,0,10"/>
            <TextBox x:Name="NameBox" Padding="10"/>
        </StackPanel>
    </DockPanel>
</Window>
