<Window x:Class="HnIptv.MainWindow" Icon="Assets/HN-IPTV.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HnIptv"
        Title="HN-IPTV — Feature Rich" Width="1360" Height="830" MinWidth="1120" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        Foreground="White" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="FooterRow" Height="35"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" x:Name="TopBar" Background="#111927" BorderBrush="#243249" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C4056" Width="39" Height="39" CornerRadius="9" Margin="0,0,11,0">
                        <Image Source="Assets/HN-IPTV.png" Stretch="Uniform" Margin="2"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="HN-IPTV" FontWeight="Bold" FontSize="21" Foreground="#FFFFFF"/>
                        <TextBlock Text="LIVE TELEVISION" FontSize="10" Foreground="#7E92AA"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="PlaylistSelector" Width="162" Height="33" Margin="0,0,7,0"
                              DisplayMemberPath="Name" SelectionChanged="PlaylistSelector_SelectionChanged" ToolTip="Saved playlists"/>
                    <Button Content="↻ Refresh" Click="Refresh_Click" Margin="0,0,7,0"/>
                    <Button Content="⚙" Click="PlaylistSettings_Click" ToolTip="Saved playlist refresh settings" Margin="0,0,7,0"/>
                    <Button Content="✕" Click="RemovePlaylist_Click" ToolTip="Remove selected playlist" Margin="0,0,7,0"/>
                    <Button Content="Rename" Click="RenamePlaylist_Click" Margin="0,0,7,0"/>
                    <Button Content="M3U URL" Click="OpenM3uUrl_Click" Margin="0,0,7,0"/>
                    <Button Content="Open M3U" Click="OpenM3u_Click" Margin="0,0,9,0"/>
                    <Button Content="Connect Xtream" Background="#167BA0" Click="XtreamConnect_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GroupsColumn" Width="215*" MinWidth="160"/>
                <ColumnDefinition x:Name="ChannelsColumn" Width="390*" MinWidth="220"/>
                <ColumnDefinition x:Name="PlayerColumn" Width="755*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <GridSplitter x:Name="GroupsDivider" Grid.Column="0" Width="6" HorizontalAlignment="Right"
                          VerticalAlignment="Stretch" Background="#31445D" Cursor="SizeWE" Panel.ZIndex="10"
                          ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragCompleted="ColumnDivider_DragCompleted"
                          ToolTip="Drag to resize groups and channels"/>
            <GridSplitter x:Name="PlayerDivider" Grid.Column="1" Width="6" HorizontalAlignment="Right"
                          VerticalAlignment="Stretch" Background="#31445D" Cursor="SizeWE" Panel.ZIndex="10"
                          ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragCompleted="ColumnDivider_DragCompleted"
                          ToolTip="Drag to resize channels and player"/>
            <!-- Left navigation -->
            <Border Grid.Column="0" Background="#111927" BorderBrush="#223147" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16,12,12">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="10,4,0,11">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="CHANNEL GROUPS" FontSize="11" Foreground="#8B9DB4" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="GroupSearchButton" Grid.Column="1" Content="⌕" FontSize="20" Padding="8,2" ToolTip="Search visible channel groups" Click="GroupSearchToggle_Click"/>
                            <Button Grid.Column="2" Content="⚙" FontSize="18" Padding="8,2" ToolTip="Hide/show entire channel groups" Click="GroupOptions_Click"/>
                        </Grid>
                        <TextBox x:Name="GroupSearchBox" Visibility="Collapsed" Background="#233147" Foreground="White"
                                 CaretBrush="White" BorderThickness="0" Padding="9,7" Margin="0,0,0,10"
                                 ToolTip="Filter visible channel groups" TextChanged="GroupSearchBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="2,10,2,0">
                        <TextBlock Text="HN-IPTV  •  LIVE TV" TextAlignment="Center" FontSize="10" Foreground="#66778E"/>
                    </StackPanel>
                    <ListBox x:Name="GroupsList" ItemContainerStyle="{StaticResource SideListStyle}" Background="Transparent"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="GroupsList_SelectionChanged" DisplayMemberPath="Name"/>
                </DockPanel>
            </Border>

            <!-- Channel browser -->
            <Border Grid.Column="1" Background="#151E2C" BorderBrush="#29374D" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,17,12,12">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="10,0,2,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ChannelGroupHeading" Text="ALL CHANNELS" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ChannelSearchButton" Content="⌕" FontSize="22" Padding="8,4" ToolTip="Search channels in the selected group"
                                        Click="ChannelSearchToggle_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="SearchBox" Visibility="Collapsed" Background="#233147" Foreground="White" CaretBrush="White"
                                 BorderThickness="0" Padding="12,9" FontSize="13" Margin="0,0,0,13"
                                 TextChanged="SearchBox_TextChanged" ToolTip="Search channels by name"/>
                        <TextBlock x:Name="ChannelCount" Text="0 CHANNELS" Foreground="#8C9BAE"
                                   FontSize="11" Margin="8,0,0,11"/>
                    </StackPanel>
                    <ListBox x:Name="ChannelsList" BorderThickness="0" Background="Transparent" Foreground="White"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ChannelsList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SideListStyle}">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ChannelItem_MouseDown"/>
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ChannelItem_MouseUp"/>
                                <EventSetter Event="MouseLeave" Handler="ChannelItem_MouseLeave"/>
                                <EventSetter Event="PreviewTouchDown" Handler="ChannelItem_TouchDown"/>
                                <EventSetter Event="PreviewTouchUp" Handler="ChannelItem_TouchUp"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="72" Loaded="ChannelRow_Loaded" Unloaded="ChannelRow_Unloaded" DataContextChanged="ChannelRow_DataContextChanged">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="7" Background="#14283B" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid>
                                            <Image x:Name="ChannelLogo" Width="36" Height="36" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Style><Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasNoLogo}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style></Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding NumberLabel}" Foreground="#6BCBE7" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasNoLogo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding EpgPreview}" FontSize="11" Foreground="#A2B9CE" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding EpgAirtime}" FontSize="10" Foreground="#738CA7" Margin="0,2,0,0"/>
                                        <ProgressBar Value="{Binding EpgProgress, Mode=OneWay}" Maximum="100" Height="2"
                                                     Background="#28384E" Foreground="#44C1EA" BorderThickness="0"
                                                     Margin="0,5,0,0" IsHitTestVisible="False"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding FavoriteIcon}" FontSize="18"
                                               Foreground="#EAC77D" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Player and EPG -->
            <Grid Grid.Column="2" x:Name="PlayerRoot" Margin="20,19,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PlayerTitleRow" Height="Auto"/>
                    <RowDefinition x:Name="PlayerVideoRow" Height="3*"/>
                    <RowDefinition x:Name="PlayerInfoRow" Height="Auto"/>
                    <RowDefinition x:Name="PlayerGuideRow" Height="2*"/>
                    <RowDefinition x:Name="PlayerControlsRow" Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" x:Name="PlayerTitleBar" Margin="3,2,0,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SelectedChannelTitle" Text="HN-IPTV" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SelectedChannelCategory" Text="Import M3U or connect a provider to begin" FontSize="12" Foreground="#92A5BB" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="☆  Favorite" VerticalAlignment="Center" Click="Favorite_Click" x:Name="FavoriteButton"/>
                </Grid>
                <Border Grid.Row="1" Background="Black" CornerRadius="9" ClipToBounds="True">
                    <local:NativeVideoHost x:Name="VideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Border>
                <Border Grid.Row="2" x:Name="StreamInfoPanel" Visibility="Collapsed" Background="#182338" CornerRadius="6" Padding="12,9" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="STREAM INFORMATION" FontWeight="SemiBold" FontSize="11" Foreground="#6ECDE7" Margin="0,0,0,5"/>
                        <TextBlock x:Name="StreamVideoInfo" Text="Video: Unavailable" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock x:Name="StreamBitrateInfo" Text="Input bitrate: Unavailable" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock x:Name="StreamAudioInfo" Text="Audio: Unavailable" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="3" x:Name="GuideRoot" Margin="0,18,0,6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4,0,0,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="PROGRAM GUIDE" FontWeight="Bold" FontSize="13" Foreground="#C7D5E7"/>
                        <TextBlock x:Name="EpgState" Grid.Column="1" Text="Select a channel" FontSize="11" Foreground="#8397B1"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="EpgList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#182338" CornerRadius="7" Padding="13,12" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeLabel}" FontSize="12" Foreground="#6ECDE7" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#8296AE" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                <WrapPanel Grid.Row="4" x:Name="PlaybackButtons" Margin="0,8,0,0">
                    <Button Content="▶ Play" Click="Play_Click" Margin="0,3,5,3"/>
                    <Button x:Name="PauseButton" Content="Ⅱ Pause" Click="Pause_Click" Margin="0,3,5,3"/>
                    <Button Content="■ Stop" Click="Stop_Click" Margin="0,3,5,3"/>
                    <Button x:Name="FullscreenButton" Content="⛶" ToolTip="Fullscreen (F)" Click="Fullscreen_Click" Margin="0,3,5,3"/>
                    <Button x:Name="PipButton" Content="PiP" ToolTip="Floating picture in picture (P)" Click="Pip_Click" Margin="0,3,5,3"/>
                    <Button Content="CC: Off" x:Name="CaptionsButton" Click="Captions_Click" ToolTip="Toggle closed captions (C), when supplied by the channel" Margin="0,3,5,3"/>
                    <Button x:Name="TranslateSpeechButton" Content="Translate speech" Click="TranslateSpeech_Click" ToolTip="Translate this player's audio entirely on this PC" Margin="0,3,5,3"/>
                    <Button x:Name="TranslateScreenButton" Content="Translate text" Click="TranslateScreen_Click" ToolTip="Read and translate visible text from the video only" Margin="0,3,5,3"/>
                    <Button Content="Translation settings" Click="TranslationSettings_Click" Margin="0,3,5,3"/>
                    <Button Content="Info" x:Name="StreamInfoButton" Click="StreamInfo_Click" ToolTip="Show stream resolution, frame rate, input bitrate and audio format" Margin="0,3,5,3"/>
                    <ComboBox x:Name="BufferSelector" Width="94" VerticalAlignment="Center" Margin="0,3,7,3"
                              ToolTip="Playback buffer. Applies on next tune." SelectionChanged="BufferSelector_SelectionChanged">
                        <ComboBoxItem Content="Fast" Tag="500"/>
                        <ComboBoxItem Content="Balanced" Tag="1200"/>
                        <ComboBoxItem Content="Resilient" Tag="3000"/>
                    </ComboBox>
                    <Button x:Name="MuteButton" Content="Mute" Click="Mute_Click" ToolTip="Mute (M)" Margin="0,3,5,3"/>
                    <Slider x:Name="VolumeSlider" Width="75" Minimum="0" Maximum="100" Value="85" TickFrequency="10" Margin="2,3,0,3"
                            ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" ToolTip="Volume"/>
                </WrapPanel>
            </Grid>
        </Grid>

        <!-- Status strip -->
        <Border x:Name="StatusStrip" Grid.Row="2" Background="#101827" BorderBrush="#243249" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready. Open M3U or connect a provider to load channels." Foreground="#8FA2BA" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Guide" Click="GuideSource_Click" ToolTip="XMLTV guide for the selected M3U playlist" Padding="8,2" FontSize="11" Margin="0,0,8,0"/>
                    <Button x:Name="UpdateButton" Content="Check for updates" Click="Update_Click" Padding="8,2" FontSize="11" ToolTip="Checks GitHub Releases"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
