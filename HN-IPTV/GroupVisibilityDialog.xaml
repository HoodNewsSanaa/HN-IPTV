<Window x:Class="HnIptv.GroupVisibilityDialog" Icon="Assets/HN-IPTV.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Channel group visibility"
        Width="465" Height="565" MinHeight="350" WindowStartupLocation="CenterOwner"
        Background="#111927" Foreground="White" FontFamily="Segoe UI">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Choose the channel groups to show" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hide All" Padding="14,8" Margin="0,0,8,0" Click="HideAll_Click"/>
                <Button Content="Show All" Padding="14,8" Margin="0,0,8,0" Click="ShowAll_Click"/>
                <Button Content="Done" Padding="18,8" Click="Done_Click"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" Foreground="#E8F2FF" IsChecked="{Binding Visible, Mode=TwoWay}" Margin="6,9" FontSize="13"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
