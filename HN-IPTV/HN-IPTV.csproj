<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HN-IPTV</AssemblyName>
    <RootNamespace>HnIptv</RootNamespace>
    <ApplicationIcon>Assets\HN-IPTV.ico</ApplicationIcon>
    <Product>HN-IPTV</Product>
    <AssemblyTitle>HN-IPTV</AssemblyTitle>
    <Company>HN-IPTV</Company>
    <Version>0.12.1</Version>
    <PlaybackEngine Condition="'$(PlaybackEngine)' == ''">mpv</PlaybackEngine>
    <PlatformTarget>x64</PlatformTarget>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\HN-IPTV.png" />
    <Resource Include="Assets\HN-IPTV.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HN-IPTV.Core\HN-IPTV.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlaybackEngine)' == 'vlc'">
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PlaybackEngine)' == 'mpv'">
    <DefineConstants>$(DefineConstants);USE_MPV</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PlaybackEngine)' == 'mpv'">
    <Compile Remove="PlaybackController.cs" />
    <Content Include="../native/mpv/libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PlaybackEngine)' == 'mpc'">
    <DefineConstants>$(DefineConstants);USE_MPC</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PlaybackEngine)' == 'mpc'">
    <Compile Remove="PlaybackController.cs" />
    <Content Include="../native/mpc-hc/**/*" Link="mpc-hc/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlaybackEngine)' != 'mpv'">
    <Compile Remove="MpvPlaybackController.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlaybackEngine)' != 'mpc'">
    <Compile Remove="MpcPlaybackController.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="TranslationRuntime/**/*" Exclude="TranslationRuntime/**/__pycache__/**;TranslationRuntime/**/*.pyc" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidatePlaybackEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PlaybackEngine)' != 'vlc' and '$(PlaybackEngine)' != 'mpv' and '$(PlaybackEngine)' != 'mpc'" Text="PlaybackEngine must be vlc, mpv or mpc." />
    <Error Condition="'$(PlaybackEngine)' == 'mpv' and !Exists('../native/mpv/libmpv-2.dll')" Text="Run prepare-mpv.ps1 before building the mpv comparison." />
    <Error Condition="'$(PlaybackEngine)' == 'mpc' and !Exists('../native/mpc-hc/mpc-hc64.exe')" Text="Run prepare-mpc.ps1 before building the MPC-HC comparison." />
  </Target>
</Project>
