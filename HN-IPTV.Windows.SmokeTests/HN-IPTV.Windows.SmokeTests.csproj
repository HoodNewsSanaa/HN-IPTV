<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HN-IPTV/HN-IPTV.csproj" Condition="'$(PublishedAppPath)' == ''" />
    <Reference Include="HN-IPTV" HintPath="$(PublishedAppPath)/HN-IPTV.dll" Condition="'$(PublishedAppPath)' != ''" />
    <Reference Include="HN-IPTV.Core" HintPath="$(PublishedAppPath)/HN-IPTV.Core.dll" Condition="'$(PublishedAppPath)' != ''" />
    <Reference Include="LibVLCSharp" HintPath="$(PublishedAppPath)/LibVLCSharp.dll" Condition="'$(PublishedAppPath)' != '' and Exists('$(PublishedAppPath)/LibVLCSharp.dll')" />
    <Content Include="$(PublishedAppPath)/**/*" Exclude="$(PublishedAppPath)/*.dll;$(PublishedAppPath)/*.exe;$(PublishedAppPath)/*.deps.json;$(PublishedAppPath)/*.runtimeconfig.json"
             Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="'$(PublishedAppPath)' != ''" />
    <Content Include="$(PublishedAppPath)/libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="'$(PublishedAppPath)' != '' and Exists('$(PublishedAppPath)/libmpv-2.dll')" />
    <Content Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
